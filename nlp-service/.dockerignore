# Allowlist: exclude everything, then let back in only what the service needs
# at runtime. The image goes to a public registry, so anything not listed here
# (training data, eval results, notebooks, .env, models/, the venv) can never
# end up in it by accident.
*
!app/
!tessdata/
!requirements.txt

# Exceptions inside the allowed folders. Unlike .gitignore, a pattern here
# matches only at the build-context root unless it starts with **/ .
**/__pycache__/
**/*.pyc
